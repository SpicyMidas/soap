# ---------------------------------------------------------------
#  Music bot settings. Copy this file to ".env" and fill it in.
#  (start.bat / start.sh do the copying for you.)
# ---------------------------------------------------------------

# REQUIRED: your bot token.
# Discord Developer Portal -> your application -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: your server's ID. Slash commands update instantly in this
# server (otherwise they're registered everywhere, which can take a minute).
# Right-click your server icon -> Copy Server ID (turn on Developer Mode first).
GUILD_ID=

# Starting volume in percent (0-200)
DEFAULT_VOLUME=80

# Seconds to wait before leaving when nothing is playing or everyone left
IDLE_TIMEOUT=300

# Maximum number of songs in the queue
MAX_QUEUE_SIZE=500

# Color of the bot's messages (hex)
EMBED_COLOR=#8B5CF6

# Optional: only needed if YouTube says "Sign in to confirm you're not a bot"
# or for age-restricted videos. See the README for how to use these.
COOKIES_FILE=
COOKIES_FROM_BROWSER=

# Optional: full path to the Opus audio library, only if the bot says it can't find it
OPUS_LIBRARY=
